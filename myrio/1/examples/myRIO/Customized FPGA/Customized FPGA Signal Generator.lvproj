<Project Type="Project" LVVersion="15008000">
	<Property Name="NI.LV.All.SourceOnly" Type="Bool">true</Property>
	<Property Name="NI.Project.Description" Type="Str">This example demonstrates how to create a custom FPGA personality to provide signal generator functionality.
This example requires myRIO-1900.</Property>
