			<Details localize="yes">Explore example programs that use features and functions of the software to better understand key concepts and programming patterns.</Details>
			<Location localize="no">3038</Location>
			<Mode>Evaluation,Licensed</Mode>
			<Type>ExampleFinder</Type>
			<ContentID>Examples</ContentID>
			<ButtonText localize="yes">Explore</ButtonText>
		</Entry>
		<Entry>
			<Title localize="yes">New Features</Title>
			<Details localize="yes">Learn what's new in LabVIEW 2021, including expanded Python support, improved MATLAB(R) support, improved Git workflows, and several usability improvements from the LabVIEW Idea Exchange.</Details>
			<Location localize="no">lvupgrade.chm::/LabVIEW_Features.html</Location>
			<Mode>Evaluation,Licensed</Mode>
			<Type>LabVIEWHelp</Type>
			<ContentID>NewFeatures</ContentID>
			<ButtonText localize="yes">Read more</ButtonText>
		</Entry>
